{
  "manifest_version": 3,
  "name": "Sembrowse Local",
  "version": "0.1.0",
  "description": "Controls a local Sembrowse decision service.",
  "action": {"default_popup": "popup.html"},
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"],
  "browser_specific_settings": {"gecko": {"id": "sembrowse@anentrypoint.dev", "strict_min_version": "109.0"}}
}
