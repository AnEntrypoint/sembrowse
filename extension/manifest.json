{
  "manifest_version": 3,
  "name": "Sembrowse WebGPU",
  "version": "0.1.5",
  "description": "Runs SemIf decisions locally through WebGPU.",
  "action": {"default_popup": "popup.html"},
  "permissions": ["storage", "activeTab", "scripting", "tabs", "windows"],
  "optional_host_permissions": ["<all_urls>"],
  "host_permissions": ["https://huggingface.co/*"],
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"},
  "browser_specific_settings": {"gecko": {"id": "sembrowse@anentrypoint.dev", "strict_min_version": "109.0"}}
}
